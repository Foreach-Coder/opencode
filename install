#!/usr/bin/env bash
set -euo pipefail

# brand:start
APP=foreachcode
PRODUCT_NAME=ForeachCode
# brand:end

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m'

usage() {
    cat <<EOF
$PRODUCT_NAME Installer

Usage: install [options]

Options:
    -h, --help           Display this help message
    -b, --binary <path>  Install a trusted local $PRODUCT_NAME binary
        --no-modify-path Do not modify shell configuration files

The enterprise download source is not configured. A local binary is required.

Example:
    ./install --binary /path/to/$APP
EOF
}

binary_path=""
no_modify_path=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -b|--binary)
            if [[ -z "${2:-}" ]]; then
                echo -e "${RED}Error: --binary requires a path argument${NC}" >&2
                exit 1
            fi
            binary_path="$2"
            shift 2
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        -v|--version)
            echo -e "${RED}Error: $PRODUCT_NAME remote releases are not configured.${NC}" >&2
            echo "Install a trusted local build with --binary <path>." >&2
            exit 1
            ;;
        *)
            echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

if [[ -z "$binary_path" ]]; then
    echo -e "${RED}Error: $PRODUCT_NAME remote install source is not configured.${NC}" >&2
    echo "Install a trusted local build with --binary <path>." >&2
    exit 1
fi

if [[ ! -f "$binary_path" ]]; then
    echo -e "${RED}Error: binary not found at $binary_path${NC}" >&2
    exit 1
fi

INSTALL_DIR="$HOME/.$APP/bin"
mkdir -p "$INSTALL_DIR"

if [[ -f "${INSTALL_DIR}/${APP}" ]]; then
    installed_version=$("${INSTALL_DIR}/${APP}" --version 2>/dev/null || true)
    if cmp -s "$binary_path" "${INSTALL_DIR}/${APP}"; then
        echo -e "${MUTED}$PRODUCT_NAME ${installed_version:-local} is already installed.${NC}"
        exit 0
    fi
    if [[ -n "$installed_version" ]]; then
        echo -e "${MUTED}Replacing installed version: ${NC}$installed_version"
    fi
fi

cp "$binary_path" "${INSTALL_DIR}/${APP}"
chmod 755 "${INSTALL_DIR}/${APP}"

add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fqx "$command" "$config_file"; then
        return
    fi
    if [[ ! -w "$config_file" ]]; then
        echo "Add this line to $config_file:"
        echo "  $command"
        return
    fi

    printf '\n# %s\n%s\n' "$APP" "$command" >> "$config_file"
}

if [[ "$no_modify_path" != "true" ]]; then
    XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
    current_shell=$(basename "${SHELL:-bash}")
    config_files=""
    command="export PATH=$INSTALL_DIR:\$PATH"

    case "$current_shell" in
        fish)
            config_files="$HOME/.config/fish/config.fish $XDG_CONFIG_HOME/fish/config.fish"
            command="fish_add_path $INSTALL_DIR"
            ;;
        zsh)
            config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
            ;;
        bash)
            config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
            ;;
        ash|sh)
            config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
            ;;
        *)
            config_files="$HOME/.profile"
            ;;
    esac

    config_file=""
    for file in $config_files; do
        if [[ -f "$file" ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -n "$config_file" ]]; then
        add_to_path "$config_file" "$command"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        echo "Add $PRODUCT_NAME to PATH:"
        echo "  $command"
    fi
fi

if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    echo "$INSTALL_DIR" >> "$GITHUB_PATH"
fi

echo -e "${PRODUCT_NAME} installed at ${MUTED}${INSTALL_DIR}/${APP}${NC}"
echo "Run: $APP"
